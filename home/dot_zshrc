# Conda is managed by the Brewfile. Initialize the first supported installation.
for conda_base in "$HOME/anaconda3" "$HOME/miniconda3" "/opt/anaconda3" "/opt/miniconda3" "/opt/homebrew/Caskroom/miniforge/base" "/opt/homebrew/Caskroom/miniconda/base"; do
  conda_executable_path="$conda_base/bin/conda"
  [[ -x "$conda_executable_path" ]] || conda_executable_path="$conda_base/condabin/conda"
  if [[ -x "$conda_executable_path" ]]; then
    __conda_setup="$("$conda_executable_path" shell.zsh hook 2>/dev/null)"
    if [[ $? -eq 0 ]]; then
      eval "$__conda_setup"
    fi
    unset __conda_setup
    break
  fi
done
