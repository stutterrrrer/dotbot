# Homebrew uses /opt/homebrew on Apple Silicon and /usr/local on Intel.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
export PATH="$HOME/.local/bin:$PATH"

# oh-my-zsh stuff
export ZSH="$HOME/.oh-my-zsh"
# Powerlevel10k is installed by Homebrew and loaded below.
ZSH_THEME=""
# plugins:
plugins=(
  git
)

source $ZSH/oh-my-zsh.sh

# These plugins are installed by Homebrew rather than Oh My Zsh. Load them
# explicitly so the setup works with either Intel or Apple Silicon Homebrew.
zsh_brew_prefix="$(brew --prefix 2>/dev/null || true)"
if [[ -r "$zsh_brew_prefix/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$zsh_brew_prefix/share/powerlevel10k/powerlevel10k.zsh-theme"
fi
if [[ -r "$zsh_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$zsh_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [[ -r "$zsh_brew_prefix/share/zsh-vi-mode/zsh-vi-mode.zsh" ]]; then
  source "$zsh_brew_prefix/share/zsh-vi-mode/zsh-vi-mode.zsh"
fi
if [[ -r "$zsh_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$zsh_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# {{{
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
