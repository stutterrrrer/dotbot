#!/usr/bin/python3
"""Run Codex with session-local jk/kj escape mappings; leave saved settings alone."""

import json
import os
from pathlib import Path
import sys


DIRECT_COMMANDS = {
    "agents", "exec", "e", "review", "login", "logout", "mcp", "mcp-server",
    "plugin", "app-server", "remote-control", "app", "completion", "update",
    "doctor", "sandbox", "debug", "apply", "a", "queue", "archive", "delete",
    "migrate-rollouts", "unarchive", "cloud", "exec-server", "features", "help",
}
VALUE_OPTIONS = {
    "-c", "--config", "--enable", "--disable", "--remote",
    "--remote-auth-token-env", "-i", "--image", "-m", "--model",
    "--local-provider", "-p", "--profile", "-s", "--sandbox", "-C", "--cd",
    "--add-dir", "-a", "--ask-for-approval",
}
SWITCH_OPTIONS = {
    "--strict-config", "--oss", "--approve-for-me", "--worktree", "--search",
    "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
    "--no-alt-screen", "--no-daemon",
}


def find_native_codex():
    """Skip this launcher's codex symlink so PATH resolution cannot recurse."""
    launcher = Path(__file__).resolve()
    for directory in os.get_exec_path():
        candidate = Path(directory) / "codex"
        if not candidate.is_file() or not os.access(candidate, os.X_OK):
            continue
        resolved = candidate.resolve()
        if resolved == launcher or resolved.name == "codex-with-jk":
            continue
        return str(candidate)
    sys.exit("The original codex executable was not found in PATH")


def uses_interactive_composer(arguments):
    """Keep automation, administrative commands, and help outside nested Vim."""
    option_arguments = arguments[:arguments.index("--")] if "--" in arguments else arguments
    if any(argument in {"-h", "--help", "-V", "--version"} for argument in option_arguments):
        return False
    argument_index = 0
    while argument_index < len(arguments):
        argument = arguments[argument_index]
        if argument == "--":
            return True
        if argument in VALUE_OPTIONS:
            argument_index += 2
            continue
        if argument in SWITCH_OPTIONS:
            argument_index += 1
            continue
        if argument.startswith("--") and "=" in argument:
            if argument.split("=", 1)[0] not in VALUE_OPTIONS:
                return False
            argument_index += 1
            continue
        if len(argument) > 2 and argument[:2] in VALUE_OPTIONS:
            argument_index += 1
            continue
        if argument.startswith("-"):
            # Unknown future options retain the native CLI's behavior.
            return False
        return argument not in DIRECT_COMMANDS
    return True


def main():
    codex_executable = find_native_codex()
    arguments = sys.argv[1:]
    if not (sys.stdin.isatty() and sys.stdout.isatty()
            and uses_interactive_composer(arguments)):
        os.execv(codex_executable, [codex_executable, *arguments])

    vim_configuration = Path(__file__).resolve().with_name("codex-terminal-maps.vim")
    if not vim_configuration.is_file():
        vim_configuration = (Path(__file__).resolve().parent.parent
                             / "share/codex-jk/codex-terminal-maps.vim")
    if not vim_configuration.is_file():
        sys.exit("codex-terminal-maps.vim was not found alongside the launcher or in ~/.local/share/codex-jk")
    codex_command = [codex_executable, "-c", "tui.vim_mode_default=true", *arguments]

    # Vim single-quoted strings escape apostrophes by doubling them. JSON keeps
    # command arguments separate, so neither shell expansion nor eval is needed.
    encoded_command = json.dumps(codex_command).replace("'", "''")
    command_configuration = (
        "let g:codex_terminal_command = json_decode('" + encoded_command + "')"
    )
    os.execv(
        "/usr/bin/vim",
        [
            "vim", "-Nu", "NONE", "-i", "NONE", "-n",
            "--cmd", command_configuration,
            "-S", str(vim_configuration),
        ],
    )


if __name__ == "__main__":
    main()
