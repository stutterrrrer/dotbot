" note: map <Action>(ActionID) would apply to select mode as well as normal mode; may prefer nnoremap.

" when vimrc source fails on some wonky updates:
" source ~/.chezmoi/ideavim_temporary_source.vim
source ~/.vimrc

" vimrc's Q now calls a real function (QuitBufferOrWindow) to fall back
" through the buffer list, which IdeaVim can't parse - overriding it here
" instead, since IdeaVim has no vim buffer-list model to fall back through
" anyway.
" This used to be an <expr> mapping calling expand('%') to tell an editable
" buffer (write & quit) from an unnamed one (quit without writing, since :wq
" there just fails with E32) - but IdeaVim doesn't implement expand(), or
" the ~600 other vimscript built-in functions, at all: confirmed against the
" IdeaVim maintainers' own vimscript-support notes. That made every Q throw
" E117: Unknown function: expand instead of running. (An earlier version
" also checked &readonly/!&modifiable first, matching real vim's
" QuitBufferOrWindow, but IdeaVim doesn't implement those options either and
" referencing &readonly threw E518: Unknown option.)
" Use IntelliJ actions instead of vimscript functions, since :action calls
" are the one thing proven reliable elsewhere in this file (m-, [c/]c, etc):
" save the current file (no-op if unmodified) and close its editor tab.
" IntelliJ editor tabs are basically never truly unnamed the way vim buffers
" can be, so this covers the cases the old <expr> version tried to split.
nnoremap Q :action SaveDocument<CR>:action CloseContent<CR>

" clear search highlights on entering Insert mode (until the next search).
" vimrc's Vim version uses feedkeys(), which IdeaVim lacks; IdeaVim doesn't
" undo :nohlsearch after an autocmd the way Vim does, so call it directly.
augroup nohlsearch_on_insert
  autocmd!
  autocmd InsertEnter * nohlsearch
augroup END

" vim-style undo
set nooldundo
" plugins (NerdTree) {{{
" related configurations are done in vimrc - ideavim compatible
set matchit
set surround

set quickscope

set easymotion
" change the common easymotion commands prefix from two leader keys to single leader key
" but don't change the double leader key altogether - plugin conflicts; like NERDTree still uses <leader>o to open directory
nmap <Leader>s <Plug>(easymotion-s)
vmap <Leader>s <Plug>(easymotion-s)

" repeat last find with <Leader>-dot to show highlights for the same input
" unsupported yet
" nmap <Leader>. <Plug>(easymotion-repeat)
" vmap <Leader>. <Plug>(easymotion-repeat)

" replaces default character search with easymotion character search
" tried AceJump-overlay f/F/t/T (and flash.nvim's f/t/search augmentation in
" vimrc) - reverted, keeping f/F/t/T and / at their plain default behavior
" in both IdeaVim and Neovim.
" nmap f <Plug>(easymotion-f)

" unsupported overwindow motions
" map <Leader><Leader>f :echo 'easymotion over window motions unsupported'<CR>
" map <Leader><Leader>w :echo 'easymotion over window motions unsupported'<CR>
" map <Leader><Leader>j :echo 'easymotion over window motions unsupported'<CR>

set NERDTree
" }}}

" replicating unsupported vim commands with keymaps {{{
" principle: align IdeaVim with vim - once IdeaVim supports a vim command
" natively, delete its workaround here so vimrc's mapping applies as-is.

" changelist (g; g, and vimrc's \ |): IdeaVim's native changelist stays in
" the current file like vim's. Don't map these to IntelliJ's
" JumpToLastChange/JumpToNextChange, which wander into other edited files.

" replace the custom function call in vimrc - delete bookmark on current line
nnoremap m- :action ToggleBookmark<CR>

" git diff view: follow vim native mappings
nnoremap [c :action PreviousDiff<Enter>
nnoremap ]c :action NextDiff<Enter>

" mimic vimrc's GitDiffAgainstHead(): open a diff of the current file against
" the last commit (HEAD). Diff.ShowDiff is a no-op here - it only fires when
" the data context already supplies a diff request (e.g. 2 selected files);
" Compare.SameVersion is the actual "current file vs HEAD" action.
nnoremap <Leader>d :action Compare.SameVersion<CR>

" in vim, this moves a split to a new tab
map <C-w>T <Action>(Unsplit)

" next error: https://stackoverflow.com/a/13097329; replicating :lnext and :lprevious
nnoremap ]e :action GotoNextError<CR>
nnoremap [e :action GotoPreviousError<CR>
" }}}

" intellij-specific mappings (not in vim) {{{
" j and k next to l: where <C-l> handles clearning highlighted searches
nnoremap <C-j> :action JumpToLastWindow<CR>
nnoremap <C-k> :action RestoreDefaultLayout<CR>
" n for No-tool-windows; 
" using control-x conflicts with decrementing numbers in vim, and C-n was just next line originally 
nnoremap <C-n> :action HideAllWindows<CR>
" p for piss-off distractions
nnoremap <C-p> :action ToggleDistractionFreeMode<CR>

" default leader key is backslash \, but mapped to space in vimrc
" open html <p>review
nnoremap <Leader>p :action WebOpenInAction<CR>
" u for strUcture
nnoremap <Leader>u :action ActivateStructureToolWindow<CR>
" m for maven
nnoremap <Leader>m :action ActivateMavenToolWindow<CR>

" fold selection: for particular file types (e.g. ending in .txt) where custom
" regions don't work
" this is a toggle that defines and removes fold region (doing it a second
" time removes it)
map zs <Action>(CollapseSelection)

" reformat code
" works on selection if anything selected; or the whole document otherwise
map <Leader>r <Action>(ReformatCode)
map <Leader>R <Action>(RunClass)
map <Leader>D <Action>(Debug)
" }}}

" macro: ex-commands stored in registers - most already in vimrc {{{
" the command for deleting all java comment-only lines 
" (has this in vim but " needs to write this again for ideavim)
" but different in that this c register is not executable because
" ideavim can't call "@c" in visual mode, so you'd have to settle for
" select -> : -> <C-R>c -> enter
let @c= 'g/\v^\s*\/\//d'
"}}}

