{{- /* chezmoi:modify-template */ -}}
{{- /*
Claude Code writes its own runtime state (permissions, model, etc.) into
~/.claude/settings.json, so this partial template only pins the keys below
and leaves every other key untouched. The existing target content arrives
through .chezmoi.stdin. Pinned:
- Vim prompt mode and jk / kj -> <Esc>
- Remote Control at startup (every CLI session can be driven from the phone)
- statusLine -> ~/.claude/statusline.sh (3 rows: prompt cache | model ·
  effort | 5-hour %, weekly %; context | cwd | branch + dirty state | lines
  changed | IDE; last question's new-input / cache-read / output tokens with
  $/MTok and total). refreshInterval 60 re-runs it every minute so the
  cache and quota countdowns stay current while idle. Edit the
  rows in home/dot_claude/executable_statusline.sh
- Notification hook -> ~/.claude/hooks/notify.sh (macOS banner when the CLI
  waits for me; silent in the desktop app)
- UserPromptSubmit hook -> ~/.claude/hooks/session-title.py (natural rolling
  CLI session titles: every 3 questions Haiku blends them into the current
  title in the background; shown from the next question; silent in the
  desktop app)
- PostToolUse (Bash) hook -> ~/.claude/hooks/brew-chezmoi-reminder.sh (fires
  in every project, not just ~/.chezmoi: after `brew install`/`uninstall`/
  `tap`/etc., reminds the assistant to ask whether the change should also be
  tracked in ~/.chezmoi's Brewfile/APPLICATION-MIGRATION-CHECKLIST.md;
  silent for brew list/info/search/update/upgrade/bundle and non-brew
  commands). hooks.PostToolUse already carries an unrelated matcherless
  iterm2 cc-status entry, so this is appended as a second array entry
  rather than overwriting the key, the same append-if-missing approach used
  for permissions.allow below.
- permissions.allow: "mcp__idea__*" (JetBrains IntelliJ MCP Server tools,
  from the "idea" MCP server registered in ~/.claude.json) auto-approved,
  never prompts, across every session/project. Appended to whatever's
  already in the array from stdin rather than overwritten, so "always
  allow" choices made in the UI survive re-apply.
- autoCompactWindow: 500000. Sonnet 5's real window is 1M, but "auto" lets
  context grow close to that before summarizing, which meant watching it
  pile up turn after turn and paying for a huge cached context on every
  request. 500k compacts well before that ceiling while giving long
  tool-heavy sessions more headroom than the previous 150k floor-adjacent
  value. Equivalent to `/autocompact 500000` or `--autocompact 500000`.

jk / kj -> <Esc> is native in Claude Code >= 2.1.208: exactly two printable
characters, INSERT mode only, second key within one second. It is read only
from this user settings file (project .claude/settings.json is ignored).
No wrapper is needed.
*/ -}}
{{- $claudeSettings := dict -}}
{{- if ne .chezmoi.stdin "" -}}
  {{- $claudeSettings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $existingAllow := dig "permissions" "allow" (list) $claudeSettings -}}
{{- $mcpIdeaRule := "mcp__idea__*" -}}
{{- $allow := $existingAllow -}}
{{- if not (has $mcpIdeaRule $existingAllow) -}}
  {{- $allow = append $existingAllow $mcpIdeaRule -}}
{{- end -}}
{{- $existingPostToolUse := dig "hooks" "PostToolUse" (list) $claudeSettings -}}
{{- $brewReminderEntry := dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" "~/.claude/hooks/brew-chezmoi-reminder.sh")) -}}
{{- $postToolUse := $existingPostToolUse -}}
{{- if not (has $brewReminderEntry $existingPostToolUse) -}}
  {{- $postToolUse = append $existingPostToolUse $brewReminderEntry -}}
{{- end -}}
{{- $claudeSettings
  | setValueAtPath "editorMode" "vim"
  | setValueAtPath "vimInsertModeRemaps.jk" "<Esc>"
  | setValueAtPath "vimInsertModeRemaps.kj" "<Esc>"
  | setValueAtPath "remoteControlAtStartup" true
  | setValueAtPath "statusLine" (dict "type" "command" "command" "~/.claude/statusline.sh" "refreshInterval" 60)
  | setValueAtPath "hooks.Notification" (list (dict "hooks" (list (dict "type" "command" "command" "~/.claude/hooks/notify.sh"))))
  | setValueAtPath "hooks.UserPromptSubmit" (list (dict "hooks" (list (dict "type" "command" "command" "~/.claude/hooks/session-title.py"))))
  | setValueAtPath "hooks.PostToolUse" $postToolUse
  | setValueAtPath "permissions.allow" $allow
  | setValueAtPath "autoCompactWindow" 500000
  | toPrettyJson }}
